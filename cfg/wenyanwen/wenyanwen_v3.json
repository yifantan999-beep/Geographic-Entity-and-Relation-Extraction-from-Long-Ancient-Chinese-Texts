{
  "base": "wenyanwen",
  "dataset": {
    "name": "wenyanwen_v3",
    "features": [22, 23, 24],
    "max_length": 256
  },
  "training": {
    "num_epochs": 35,
    "patience": 15,
    "dropout": 0.15,
    "batch_size": 2,
    "gradient_accumulation": 4,
    "lr_t5": 1e-5,
    "lr_iter": 4e-4,
    "lr_scheduler": "linear_with_warmup",
    "task_lr_scheduler": "linear_with_warmup",
    "warmup_steps": 0.1,
    "task_warmup_steps": 0.15,
    "weight_decay": 0.05,
    "task_weight_decay": 0.05,
    "optimize_for": "ere",
    "metric_average": "micro"
  }
}
