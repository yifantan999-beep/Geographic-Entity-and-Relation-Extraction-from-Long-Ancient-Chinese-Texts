{
  "base": "wenyanwen",
  "dataset": {
    "name": "wenyanwen_v2",
    "features": [22, 23],
    "max_length": 256
  },
  "training": {
    "num_epochs": 30,
    "patience": 12,
    "dropout": 0.25,
    "batch_size": 2,
    "gradient_accumulation": 4,
    "lr_t5": 2e-5,
    "lr_iter": 3e-4,
    "warmup_steps": 0.05,
    "task_warmup_steps": 0.1,
    "optimize_for": "ere",
    "metric_average": "micro"
  }
}
