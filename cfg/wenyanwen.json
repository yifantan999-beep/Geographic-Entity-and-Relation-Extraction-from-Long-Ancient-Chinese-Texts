{
  "dataset": {
    "name": "wenyanwen",
    "features": 0,
    "max_length": 512,
    "entity_nest_depth": 1,
    "splits": {
      "train": "train.json",
      "test": "test.json",
      "eval": "dev.json",
      "types": "types.json"
    },
    "data_dir": "long_context"
  },
  "training": {
    "patience": 10,
    "max_epochs": 50,
    "num_epochs": 50,
    "lr_t5": 3e-5,
    "lr_iter": 1e-4,
    "lr_scheduler": "linear_with_warmup",
    "weight_decay": 0.1,
    "warmup_steps": 0.05,
    "task_weight_decay": 0.1,
    "task_warmup_steps": 0.1,
    "task_lr_scheduler": "linear_with_warmup",

    "batch_size": 2,
    "dropout": 0.3,
    "d_ff": 0,
    "activation_fn": "relu",
    "gradient_accumulation": 16,
    "metric_average": "micro",
    "optimize_for": "ere"
  }
}
